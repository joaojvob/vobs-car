# Supabase: painel do projeto → Project Settings → API Keys
# O prefixo NUXT_ faz o Nuxt ler os valores em tempo de execução (runtimeConfig).

NUXT_PUBLIC_SUPABASE_URL=https://<id-do-projeto>.supabase.co

# Chave publicável (sb_publishable_...). Vai para o navegador; o acesso aos dados é controlado pelo RLS.
NUXT_PUBLIC_SUPABASE_KEY=

# Chave secreta (sb_secret_...). Só no servidor: ignora o RLS e nunca pode chegar ao cliente.
NUXT_SUPABASE_SECRET_KEY=

# API da FIPE (fipe.api.br/register). Opcional: sem token, o limite diário é contado por IP.
NUXT_FIPE_API_TOKEN=
